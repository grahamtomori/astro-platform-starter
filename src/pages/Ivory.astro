---
import '../styles/global.css';
const year = new Date().getFullYear();
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Ivory | Graham Tomori</title>

    </head>

    <body class="font-sans bg-[#cfc6b8] text-gray-100 flex flex-col min-h-screen overflow-auto">
        <!-- Navbar -->
        <nav class="fixed top-0 left-0 w-full bg-[#3b2f2f] shadow-md z-50">
            <div class="flex justify-between items-center text-white w-full pl-3">
                <div class="flex items-center space-x-3">
                    <img src="/images/stretched-globe-csa-images.png" class="h-16 w-auto object-contain" />
                    <div class="flex flex-col justify-center">
                        <span class="text-xl font-bold text-gray-100">Graham Tomori</span>
                        <span class="text-sm italic text-gray-300">Curiosity in Motion</span>
                    </div>
                </div>

                <div class="space-x-6 mr-6">
                    <a href="/" class="hover:text-[#c4b78b]">Home</a>
                    <a href="/about" class="hover:text-[#c4b78b]">About</a>
                    <a href="/projects" class="hover:text-[#c4b78b]">Projects</a>
                    <a href="/Ivory" class="hover:text-[#c4b78b] font-bold">Ivory</a>
                    <a href="/resume" class="hover:text-[#c4b78b]">Resume</a>
                    <a href="/contact" class="hover:text-[#c4b78b]">Contact</a>
                </div>
            </div>
        </nav>

        <!-- Category Tabs -->
        <div class="flex justify-center pt-36 px-6 z-40">
            <div class="bg-white rounded-xl w-full max-w-4xl shadow-sm py-3">
                <div class="flex justify-center space-x-10 text-[#3B2F2F] text-lg font-semibold">
                    <!-- Corrected links for top-level pages -->
                    <a href="/Philosophy" class="hover:underline">Philosophy</a>
                    <a href="/Economics" class="hover:underline">Economics</a>
                    <a href="/Personal" class="hover:underline">Personal</a>
                </div>
            </div>
        </div>

        <!-- Main Container -->
        <section class="min-h-screen flex items-start justify-center pt-0.1 px-6 pb-24">
            <div class="bg-white shadow-lg rounded-xl w-full max-w-4xl p-12 leading-relaxed text-[#3B2F2F] mt-6">
                <!-- Header -->
                <h1 class="text-4xl font-serif font-bold mb-6 text-center">Ivory</h1>

                <!-- Intro -->
                <p class="leading-relaxed mb-4">
                    This is the beginning of my journal space. Here I'll be displaying the process of my thinking as I develop my future intellectual
                    frameworks. A lot of this will be based off personal experiences, and academic research, but will be backed up by sufficient arguments and
                    explanations. Everything written here is subject to future change as I grow and develop my individual.
                </p>

                <!-- Signature -->
                <div class="mt-6">
                    <svg viewBox="0 0 270 78" xmlns="http://www.w3.org/2000/svg" style="width:270px;height:78px;">
                        <g fill="none" stroke="#3B2F2F" stroke-linecap="round" stroke-linejoin="round">
                            <!-- G -->
                            <path d="M 43,11 L 13,11 L 8,54 L 39,62 L 39,36 L 24,36" stroke-width="3"/>
                            <!-- Period -->
                            <circle cx="48" cy="59" r="2.3" fill="#3B2F2F" stroke="none"/>
                            <!-- T crossbar -->
                            <line x1="56" y1="21" x2="77" y2="21" stroke-width="2.5"/>
                            <!-- T stem -->
                            <line x1="67" y1="21" x2="65" y2="60" stroke-width="2.5"/>
                            <!-- o -->
                            <ellipse cx="80" cy="44" rx="8" ry="11" stroke-width="2.2"/>
                            <!-- m: two arches with middle downstroke -->
                            <path d="M 90,60 L 90,32 Q 97,22 104,32 Q 111,22 118,32 L 118,60 M 104,32 L 104,60" stroke-width="2.2"/>
                            <!-- o -->
                            <ellipse cx="133" cy="44" rx="8" ry="11" stroke-width="2.2"/>
                            <!-- r -->
                            <line x1="143" y1="60" x2="143" y2="32" stroke-width="2.2"/>
                            <path d="M 143,38 Q 148,27 156,31" stroke-width="2.2"/>
                            <!-- i dot -->
                            <circle cx="163" cy="23" r="2.5" fill="#3B2F2F" stroke="none"/>
                            <!-- i stem -->
                            <line x1="163" y1="31" x2="163" y2="60" stroke-width="2.2"/>
                            <!-- underline sweep -->
                            <path d="M 8,70 Q 90,80 174,66" stroke-width="2" fill="none"/>
                        </g>
                    </svg>
                </div>

                <!-- Divider -->
                <hr class="mt-6 mb-10 border-t-2 border-[#3B2F2F]/30" />

                <!-- Highlights Header -->
                <h2 class="text-3xl font-serif font-bold text-center mb-6">Highlights</h2>
                <p class="text-center leading-relaxed mb-6 text-lg">This will be a showcase of my best work under Ivory.</p>

                <p class="text-center text-xl tracking-widest my-6 text-[#3B2F2F]/70">* * * * *</p>

                <!-- Scrollable Page -->
                <div
                    class="bg-white shadow-lg rounded-xl mx-auto"
                    style="width: 816px; height: 1056px; overflow-y: scroll; padding: 60px; border: 1px solid rgba(0,0,0,0.15);"
                >
                    <p class="text-center leading-relaxed mb-6 text-lg">Highlighted Essays will go here</p>
                </div>

                <hr class="mt-12 mb-4 border-t-2 border-[#3B2F2F]/30" />
            </div>
        </section>

        <!-- Footer -->
        <footer class="bg-[#3b2f2f] text-gray-100 py-6 mt-auto">
            <div class="max-w-6xl mx-auto px-6 text-center">
                © {year} Graham Tomori. All rights reserved.
            </div>
        </footer>
    </body>
</html>
