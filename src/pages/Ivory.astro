---
import '../styles/global.css';
const year = new Date().getFullYear();

const latinNames = [
    "De Natura Rerum",      "Cogito Ergo Sum",       "Vox Populi Vox Dei",
    "Alea Iacta Est",       "In Medias Res",          "Sine Qua Non",
    "Tabula Rasa",          "Ad Astra Per Aspera",    "Carpe Diem",
    "Dum Spiro Spero",      "Et Tu Brute",            "Fiat Lux",
    "Gloria Mundi",         "Homo Homini Lupus",      "In Vino Veritas",
    "Labor Omnia Vincit",   "Magna Carta",            "Nil Desperandum",
    "Omnia Vincit Amor",    "Per Aspera Ad Astra",    "Quid Pro Quo",
    "Res Ipsa Loquitur",    "Semper Fidelis",         "Tempus Fugit",
    "Ultima Ratio Regum",   "Veritas Lux Mea",        "Virtus Et Honor",
    "Vive Ut Vivas",        "Vox Clamantis",          "Dum Vivimus Vivamus"
];
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>IVORY | Graham Tomori</title>
    </head>

    <body class="font-sans bg-[#cfc6b8] text-gray-100 flex flex-col min-h-screen overflow-auto">
        <!-- Navbar -->
        <nav class="fixed top-0 left-0 w-full bg-[#3b2f2f] shadow-md z-50">
            <div class="flex justify-between items-center text-white w-full pl-3">
                <div class="flex items-center space-x-3">
                    <img src="/images/stretched-globe-csa-images.png" class="h-16 w-auto object-contain" />
                    <div class="flex flex-col justify-center">
                        <span class="text-xl font-bold text-gray-100">Graham Tomori</span>
                        <span class="text-sm italic text-gray-300">Curiosity in Motion</span>
                    </div>
                </div>
                <div class="space-x-6 mr-6">
                    <a href="/" class="hover:text-[#c4b78b]">Home</a>
                    <a href="/about" class="hover:text-[#c4b78b]">About</a>
                    <a href="/Ivory" class="hover:text-[#c4b78b] font-bold">IVORY</a>
                    <a href="/resume" class="hover:text-[#c4b78b]">Resume</a>
                    <a href="/contact" class="hover:text-[#c4b78b]">Contact</a>
                </div>
            </div>
        </nav>

        <!-- Category Tabs -->
        <div class="flex justify-center pt-36 px-6 z-40">
            <div class="bg-white rounded-xl w-full max-w-4xl shadow-sm py-4">
                <div class="w-full text-center mb-3"><a href="/Ivory" class="text-2xl font-bold" style="color:#2c4a2c; letter-spacing:0.2em; padding-left:0.2em;">IVORY</a></div>
                <hr class="border-t border-[#3B2F2F]/20 mx-8 mb-3" />
                <div class="flex justify-center space-x-10 text-[#3B2F2F] text-lg font-semibold" style="margin-left:-0.9rem;">
                    <a href="/Philosophy" class="hover:underline">Philosophy</a>
                    <a href="/Political" class="hover:underline">Political</a>
                    <a href="/Personal" class="hover:underline">Personal</a>
                </div>
            </div>
        </div>

        <!-- Main Container -->
        <section class="min-h-screen flex items-start justify-center pt-0.1 px-6 pb-24">
            <div class="bg-white shadow-lg rounded-xl w-full max-w-4xl p-12 leading-relaxed text-[#3B2F2F] mt-6">
                <!-- Header -->
                <h1 class="text-4xl font-serif font-bold mb-6 text-center">IVORY</h1>

                <!-- Intro -->
                <p class="leading-relaxed mb-4">
                    This is the beginning of my journal space. Here I'll be displaying the process of my thinking as I develop my future intellectual
                    frameworks. A lot of this will be based off personal experiences, and academic research, but will be backed up by sufficient arguments and
                    explanations. Everything written here is subject to future change as I grow and develop my individual.
                </p>

                <!-- Signature -->
                <div class="mt-6">
                    <img src="/images/grahamtomorisig.png" alt="Graham Tomori signature" style="height:100px;width:auto;" />
                </div>

                <!-- Divider -->
                <hr class="mt-6 mb-10 border-t-2 border-[#3B2F2F]/30" />

                <!-- Highlights Header -->
                <h2 class="text-3xl font-serif font-bold text-center mb-6">Highlights</h2>
                <p class="text-center leading-relaxed mb-6 text-lg">My best work under IVORY.</p>

                <p class="text-center text-xl tracking-widest my-6 text-[#3B2F2F]/70">* * * * *</p>

                <!-- Scrollable Pages Container -->
                <div
                    id="ivory-pages"
                    style="width:816px; height:720px; overflow-y:scroll; background:#ede8e0; border:1px solid rgba(0,0,0,0.15); border-radius:12px; padding:20px; margin:0 auto; box-sizing:border-box;"
                >
                    <!-- Table of Contents Page (short) -->
                    <div id="toc-page" style="width:100%; background:white; padding:48px 60px 56px; margin-bottom:20px; box-shadow:0 2px 8px rgba(0,0,0,0.1); box-sizing:border-box;">
                        <h2 style="text-align:center; color:#2c4a2c; letter-spacing:0.2em; padding-left:0.2em; font-size:1.5rem; font-weight:bold; font-family:Georgia,serif; margin-bottom:32px;">IVORY</h2>
                        <!-- Two-column ToC -->
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px 48px;">
                            {Array.from({length: 15}, (_, i) => (
                                <>
                                    <!-- Left column: entries 1-15 -->
                                    <a
                                        onclick={`scrollToIvoryPage('page-${i + 1}')`}
                                        style="display:flex; align-items:baseline; cursor:pointer; text-decoration:none; color:#3B2F2F; gap:4px; font-family:Georgia,serif; font-size:0.82rem;"
                                    >
                                        <span style="white-space:nowrap;">{latinNames[i]}</span>
                                        <span style="flex:1; border-bottom:1px dashed #aaa; min-width:12px; position:relative; top:-3px;"></span>
                                        <span style="white-space:nowrap;">{i + 1}</span>
                                    </a>
                                    <!-- Right column: entries 16-30 -->
                                    <a
                                        onclick={`scrollToIvoryPage('page-${i + 16}')`}
                                        style="display:flex; align-items:baseline; cursor:pointer; text-decoration:none; color:#3B2F2F; gap:4px; font-family:Georgia,serif; font-size:0.82rem;"
                                    >
                                        <span style="white-space:nowrap;">{latinNames[i + 15]}</span>
                                        <span style="flex:1; border-bottom:1px dashed #aaa; min-width:12px; position:relative; top:-3px;"></span>
                                        <span style="white-space:nowrap;">{i + 16}</span>
                                    </a>
                                </>
                            ))}
                        </div>
                    </div>

                    <!-- Pages 1–30 -->
                    {Array.from({length: 30}, (_, i) => (
                        <div
                            id={`page-${i + 1}`}
                            style="width:100%; height:1056px; background:white; padding:72px 60px; margin-bottom:20px; box-shadow:0 2px 8px rgba(0,0,0,0.1); box-sizing:border-box; position:relative;"
                        >
                            <span style="position:absolute; bottom:36px; left:50%; transform:translateX(-50%); color:#ccc; font-size:0.8rem; font-family:Georgia,serif;">{i + 1}</span>
                        </div>
                    ))}
                </div>

                <hr class="mt-12 mb-4 border-t-2 border-[#3B2F2F]/30" />
            </div>
        </section>

        <!-- Footer -->
        <footer class="bg-[#3b2f2f] text-gray-100 py-6 mt-auto">
            <div class="max-w-6xl mx-auto px-6 text-center">
                © {year} Graham Tomori. All rights reserved.
            </div>
        </footer>
    </body>
</html>

<script>
    // Trap scroll inside the pages container — prevent bleed to page
    const ivoryPages = document.getElementById('ivory-pages');
    if (ivoryPages) {
        ivoryPages.addEventListener('mouseenter', () => {
            document.body.style.overflow = 'hidden';
            document.documentElement.style.overflow = 'hidden';
        });
        ivoryPages.addEventListener('mouseleave', () => {
            document.body.style.overflow = '';
            document.documentElement.style.overflow = '';
        });
    }

    // Scroll to a specific page within the container
    function scrollToIvoryPage(pageId) {
        const container = document.getElementById('ivory-pages');
        const page = document.getElementById(pageId);
        if (!container || !page) return;
        const containerRect = container.getBoundingClientRect();
        const pageRect = page.getBoundingClientRect();
        container.scrollTop += (pageRect.top - containerRect.top) - 20;
    }
</script>
